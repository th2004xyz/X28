# ==============================================================================
# X28 平台内容运营辅助工具 配置文件示例
#
# 敏感凭证 (API Key / Bearer Token) 优先存储在系统 keyring:
#   • Windows:  控制面板 → 凭据管理器
#   • macOS:    钥匙串
#   • Linux:    Secret Service (GNOME Keyring / KWallet)
#
# 首次启动会弹出配置向导，自动写入 keyring；
# 也可在主界面右上角点「⚙️」按钮重新配置。
#
# 此 .env 仅放非敏感配置 + 旧版凭证（向后兼容）。
# 复制此文件并重命名为 .env，然后按需填写。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI 接口配置 (Gemini 免费版推荐)
# ------------------------------------------------------------------------------
# AI 提供商，可选值: gemini, openai, anthropic (默认: gemini)
LLM_PROVIDER=gemini

# Google Gemini 配置 (在 Google AI Studio 免费申请 API Key)
# 推荐通过配置向导存入 keyring，下面 .env 仅作为回退
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI 配置 (如果您使用的是 OpenAI 免费/测试 Key 或中转 Key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 如果使用 OpenAI 代理或中转接口，可在此填写代理地址 (可选)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude 配置 (如果您使用的是 Anthropic Key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-5-fable

# ------------------------------------------------------------------------------
# 2. X (Twitter) 数据抓取配置
# ------------------------------------------------------------------------------
# X API v2 Bearer Token (官方 API 凭证，可选。如不填则自动降级到 Nitter 抓取)
X_BEARER_TOKEN=

# Nitter 网关列表 (当官方 API 失败或未配置时，按顺序轮询以下网关抓取)
# 多个网关请用英文逗号隔开；失败的网关会被短期冷却(默认5分钟)，自动切换到下一个
# 留空则使用内置默认列表 (twiiit.com + 多个直连实例)
NITTER_GATEWAYS=https://twiiit.com,https://nitter.poast.org,https://nitter.net,https://nitter.cz,https://nitter.privacydev.net,https://bird.trom.tf,https://nitter.fdn.fr
